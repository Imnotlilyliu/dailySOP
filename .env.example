# ============================================================
# Daily SOP — Environment Variables
# ============================================================
# Copy this file to `.env` for local dev, or set these in Railway
# Dashboard for production.

# ---- Database ----
# Local: PostgreSQL >= 15
# Railway: Postgres plugin auto-injects this
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# ---- Auth (REQUIRED in production) ----
# JWT signing secret — generate with: openssl rand -base64 32
# Dev default is used if unset; production FAILS if unset.
JWT_SECRET="dev-secret-please-change-in-production"

# ---- CORS (production: set to frontend domain) ----
# Comma-separated list of allowed origins.
# Dev: http://localhost:3001
# Prod: https://your-frontend.up.railway.app
CORS_ORIGIN="http://localhost:3001,http://127.0.0.1:3001"

# ---- API public URL (for OpenAPI spec) ----
# Dev: http://localhost:3000
# Prod: https://your-api.up.railway.app
API_BASE_URL="http://localhost:3000"

# ---- Runtime ----
NODE_ENV="development"
PORT=3000
